<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="box_bot">
	<xacro:property name="rname" value="$(arg rname)" />
	<xacro:property name="rlen" value="$(arg rlen)" />
	<xacro:property name="rwidth" value="$(arg rwidth)" />
	<material name="color_r1">
		<color rgba="0.9 0.04 0.34 1"/>
	</material>
	<material name="color_r2">
		<color rgba="1.0 1.0 0.0 1"/>
	</material>
	<material name="color_r3">
		<color rgba="0.02 0.39 0.28 1"/>
	</material>
	<material name="color_r4">
		<color rgba="0.45 0.55 0.14 1"/>
	</material>
	<material name="color_r5">
		<color rgba="0.81 0.98 0.4 1"/>
	</material>

  <link name="${rname}/base_link">
    <parent link="${rname}/odom"/>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${rlen} ${rwidth} 0.1"/>
      </geometry>
      <material name="color_${rname}"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${rlen} ${rwidth} 0.1"/>
      </geometry>
    </collision>
  </link>

</robot>
